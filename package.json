{
  "name": "syncytium-md",
  "version": "0.1.0",
  "description": "Universal Context & Handoff Bridge for AI Coding Tools (IDEs, VSCode extensions, CLIs, and MCP)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "syncytium": "./dist/cli/index.js",
    "syncytium-mcp": "./dist/mcp/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "cursor",
    "copilot",
    "cline",
    "claude-code",
    "antigravity",
    "windsurf",
    "trae",
    "opencode",
    "mcp",
    "model-context-protocol",
    "markdown-bridge",
    "agent-handoff"
  ],
  "author": "SyncytiumMD Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "gray-matter": "^4.0.3",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
