{
  "name": "syncytium-md",
  "version": "0.2.2",
  "description": "Universal Context & Handoff Bridge for AI Coding Tools (IDEs, VSCode extensions, CLIs, and MCP)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "syncytium-md": "dist/cli/index.js",
    "syncytium": "dist/cli/index.js",
    "syncytium-mcp": "dist/mcp/index.js"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:watch": "node --experimental-strip-types --test --watch tests/*.test.ts",
    "verify": "npm run build && npm run typecheck && npm test",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "ai",
    "cursor",
    "copilot",
    "cline",
    "claude-code",
    "antigravity",
    "windsurf",
    "trae",
    "opencode",
    "codex",
    "gemini-cli",
    "agents-md",
    "mcp",
    "model-context-protocol",
    "markdown-bridge",
    "agent-handoff",
    "cursorrules",
    "claude-md",
    "ai-agents",
    "context-engineering",
    "adrs",
    "multi-agent"
  ],
  "author": "Miraç Birben",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrcbrbn5361/SyncytiumMD.git"
  },
  "bugs": {
    "url": "https://github.com/mrcbrbn5361/SyncytiumMD/issues"
  },
  "homepage": "https://github.com/mrcbrbn5361/SyncytiumMD#readme",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "gray-matter": "^4.0.3",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
